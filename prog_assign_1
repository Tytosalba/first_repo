# This is a code for basic arithmetic operations in Python using input from the user.
print("Please enter an integer: ")
integer1 = int(input())
print("Please enter another integer: ")
integer2 = int(input())
print("Please select an operation to perform: ")
print("1. Addition ")
print("2. Subtraction ")
print("3. Multiplication ")
print("4. Division ")
operation = int(input("Enter your choice (1/2/3/4): "))
if operation == 1:
    result = integer1 + integer2
elif operation == 2:
    result = integer1 - integer2
elif operation == 3:
    result = integer1 * integer2
elif operation == 4:
    result = integer1 / integer2
else:
    print("Invalid operation selection.")
output = print("The result of the operation is: ", result)
